const cfg={apiKey:"AIzaSyAyUyPLlkvBZHnI9yqnmJ8w8r7WSYZ5gls",authDomain:"scansafeafrica-boards.firebaseapp.com",projectId:"scansafeafrica-boards",storageBucket:"scansafeafrica-boards.firebasestorage.app",messagingSenderId:"130832397347",appId:"1:130832397347:web:1f06f1b998d5655160ed96",measurementId:"G-9LP28329PL"};
const app=initializeApp(cfg);const db=getFirestore(app);window.db=db;window.qinisoDB=db;window.f={collection,addDoc,serverTimestamp};window.qinisoAdd=addDoc;window.qinisoColl=collection;window.qinisoTime=serverTimestamp;
console.log('✅ QINISO SCAN V26 ACTIVE - AUTO TRACE + CAMERA TRAP + DEVICE');
</script></head>
<body class="bg-[#0f0f0f] min-h-screen">
